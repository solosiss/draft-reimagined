{
  "name": "draft-reimagined",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "electron": "vite build && electron .",
    "electron:dev": "ELECTRON_DEV_URL=http://localhost:5173 electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "gsap": "^3.15.0"
  },
  "description": "Pick and ban tool for League of Legends coaches and broadcasts, with a tournament-style final screen.",
  "author": "Tomás Salas",
  "license": "MIT",
  "homepage": "https://github.com/solosiss/draft-reimagined",
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.solosiss.draft-reimagined",
    "productName": "Draft Reimagined",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "solosiss",
        "repo": "draft-reimagined",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
